post_install() {
  cat <<'MSG'
==> hushtype: run `hushtype init` to write a config, then start it from the app menu.
==> For hold-to-talk on any key combo: sudo usermod -aG input $USER, then reboot.
==> GPU (NVIDIA): install python-ctranslate2-cuda. Check everything with `hushtype doctor`.
==> The first start downloads the Whisper model (~1.6 GB).
MSG
}

post_upgrade() {
  :
}
